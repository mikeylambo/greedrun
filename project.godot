; Engine configuration file.
; Jo: Greedrun Godot Port
config_version=5

[application]
config/name="Jo: Greedrun"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]
MetaSave="*res://autoload/meta_save.gd"
Progression="*res://autoload/progression.gd"
Economy="*res://autoload/economy.gd"
GameState="*res://autoload/game_state.gd"
AscensionModifiers="*res://autoload/ascension_modifiers.gd"
Daily="*res://autoload/daily.gd"

[gui]

theme/custom="res://ui/greedrun_theme.tres"

[display]
window/size/viewport_width=960
window/size/viewport_height=640
window/size/window_width_override=960
window/size/window_height_override=640
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
viewport/hdr_2d=true
